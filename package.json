{
  "name": "koyokana-studio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "configure:firebase": "node scripts/configure-firebase.mjs",
    "prestart": "npm run configure:firebase",
    "start": "ng serve",
    "start:emulator": "ng serve --configuration emulator",
    "prebuild": "npm run configure:firebase",
    "build": "ng build",
    "build:emulator": "ng build --configuration emulator",
    "prewatch": "npm run configure:firebase",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "predeploy": "npm run configure:firebase",
    "deploy": "ng build && firebase deploy",
    "deploy:auth": "firebase deploy --only auth --project koyokana-studio",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-koyokana",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-koyokana \"node --test tests/rules.test.mjs\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.3",
    "@angular/cli": "^20.3.3",
    "@angular/compiler-cli": "^20.3.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
